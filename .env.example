# ---- Personalización (opcional) ----
# Nombre de la app. Se usa en el header y en el título del navegador.
NEXT_PUBLIC_APP_TITLE=LoL Squad Stats
# Subtítulo bajo el título (oculto en mobile)
NEXT_PUBLIC_APP_SUBTITLE=Datos reales de Riot. Sin inventos.
# Descripción para SEO / al compartir el link
NEXT_PUBLIC_APP_DESCRIPTION=Dashboard de LoL para tu squad
# Link al código fuente (aparece en el pie de la app)
NEXT_PUBLIC_APP_REPO_URL=https://github.com/tu-usuario/lol-squad

# URL pública del sitio. Opcional: en Vercel se detecta sola.
# Ponela solo si el dominio no es el de Vercel, porque de esto depende que
# la imagen de preview funcione al compartir el link por WhatsApp.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ---- Riot API ----
# Key de desarrollo: https://developer.riotgames.com (vence cada 24h)
RIOT_API_KEY=
RIOT_REGION=americas
RIOT_ROUTING=la2
# Barra de estado + modal para cargar la key desde la app.
# Por defecto está OCULTA (si la key está en el entorno, esa barra es ruido).
# Poné 'true' si querés poder cargar o renovar la key desde la interfaz.
NEXT_PUBLIC_SHOW_RIOT_KEY_UI=

# ---- Gemini (Coach IA) ----
# Key gratuita: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=
# Si este modelo deja de estar disponible, la app cae al siguiente
# de la lista automáticamente (3.7 → 3.5 → 3 preview).
GEMINI_MODEL=gemini-3.7-flash

# ---- Supabase (persistencia en la nube) ----
# Proyecto gratuito en https://supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
